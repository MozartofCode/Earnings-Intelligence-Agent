# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:4200

# Defaults to local SQLite when unset. Point at Postgres/AWS RDS later, e.g.:
# DATABASE_URL=postgres://user:password@host:5432/earnings_agent
DATABASE_URL=

# --- Agent (used once you implement intelligence/services/agent/) ---
# LLM_PROVIDER selects which chat model graph.py builds: "groq" (free tier,
# fast) or "anthropic". Only the matching API key below is required.
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-120b
ANTHROPIC_API_KEY=sk-ant-...

# SEC EDGAR requires a descriptive User-Agent identifying you/your app.
EDGAR_USER_AGENT=Earnings Intelligence Agent (you@example.com)

# SEARCH_PROVIDER=duckduckgo needs no API key (ddgs package).
# Swap to tavily/brave/serper and set the matching key below if you hit
# DuckDuckGo rate limits.
SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=tvly-...
BRAVE_API_KEY=BSA...
SERPER_API_KEY=...

WATCHLIST=AAPL,MSFT,NVDA
CHROMA_PERSIST_DIR=./data/chroma_db

# --- Async task queue ---
# /analyze enqueues a Celery task instead of blocking. Needs Redis + a worker:
#   redis-server
#   celery -A config worker -l info
#   celery -A config beat -l info   (for the scheduled WATCHLIST run)
# Set CELERY_TASK_ALWAYS_EAGER=True to run tasks synchronously in-process
# instead (no Redis/worker needed) for quick local testing.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=False
WATCHLIST_SCHEDULE_DAY=mon
WATCHLIST_SCHEDULE_HOUR=6
WATCHLIST_SCHEDULE_MINUTE=0

# --- API protection ---
# Caps requests to POST /api/tickers/{symbol}/analyze/ (it triggers billed
# LLM calls) per client, e.g. "10/hour" or "5/day".
ANALYZE_THROTTLE_RATE=10/hour
# If set, unsafe requests (POST/DELETE) must send `Authorization: Token
# <value>`. Leave unset for local dev — the bundled frontend sends no auth
# header. Set this before exposing the API beyond localhost.
API_AUTH_TOKEN=
