# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:4200

# Defaults to local SQLite when unset. Point at Postgres/AWS RDS later, e.g.:
# DATABASE_URL=postgres://user:password@host:5432/earnings_agent
DATABASE_URL=

# --- Agent (used once you implement intelligence/services/agent/) ---
# LLM_PROVIDER selects which chat model graph.py builds: "groq" (free tier,
# fast) or "anthropic". Only the matching API key below is required.
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile
ANTHROPIC_API_KEY=sk-ant-...

# SEARCH_PROVIDER=duckduckgo needs no API key (duckduckgo-search package).
# Swap to tavily/brave/serper and set the matching key below if you hit
# DuckDuckGo rate limits.
SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=tvly-...
BRAVE_API_KEY=BSA...
SERPER_API_KEY=...

WATCHLIST=AAPL,MSFT,NVDA
CHROMA_PERSIST_DIR=./data/chroma_db
