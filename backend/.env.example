# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:4200

# Defaults to local SQLite when unset. Point at Postgres/AWS RDS later, e.g.:
# DATABASE_URL=postgres://user:password@host:5432/earnings_agent
DATABASE_URL=

# --- Agent (used once you implement intelligence/services/agent/) ---
ANTHROPIC_API_KEY=sk-ant-...
TAVILY_API_KEY=tvly-...
BRAVE_API_KEY=BSA...
SERPER_API_KEY=...
SEARCH_PROVIDER=duckduckgo
WATCHLIST=AAPL,MSFT,NVDA
CHROMA_PERSIST_DIR=./data/chroma_db
